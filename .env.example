# Copy to .env and adjust. Read at startup by config.py — except HOST/PORT,
# which are read by the `python app.py` entrypoint.

# Secret used to sign session/flash cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated per process (sessions won't survive a restart).
SECRET_KEY=

# Enable the Werkzeug debugger/reloader. NEVER enable in production (RCE risk).
FLASK_DEBUG=0

# Where media is stored. Defaults to ./downloads and ./trimmed_videos next to app.py.
DOWNLOAD_FOLDER=
TRIMMED_FOLDER=

# SQLite file for the download history. Defaults to ./mediasculp.db.
DATABASE=

# Path to the ffmpeg binary. Leave blank to resolve ffmpeg from PATH.
# Example (Windows): C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_LOCATION=

# Maximum upload size in bytes (default 524288000 = 500 MB).
MAX_UPLOAD_BYTES=524288000

# How many downloads run at once; extras queue.
MAX_CONCURRENT_DOWNLOADS=3

# Refuse to start a download below this free space (bytes); 0 disables.
MIN_FREE_BYTES=209715200

# Set to 1 to run `pip install -U yt-dlp` at startup (restart to load the new version).
AUTO_UPDATE_YTDLP=0

# Track yt-dlp's nightly channel instead of stable. Nightly ships YouTube fixes
# days early — often the difference between a video downloading and returning
# only storyboards. Affects AUTO_UPDATE_YTDLP and the packaged app's self-update.
# Defaults on for the packaged desktop app, off for a dev checkout.
YTDLP_NIGHTLY=0

# JS runtime for yt-dlp's challenge / PO-token solver. Many YouTube videos need
# Node >=22 or Deno; without one, extraction silently degrades to storyboards.
# Blank = auto-detect (deno, then node on PATH). Set a name (node/deno) or a path.
YTDLP_JS_RUNTIME=

# Optional single password to gate the whole app (recommended before exposing it
# beyond localhost). Leave blank to disable auth. Set a fixed SECRET_KEY too so the
# login session survives a restart.
AUTH_PASSWORD=

# YouTube auth for videos gated behind "Sign in to confirm you're not a bot".
# Easiest: just drop an exported cookies.txt (or www.youtube.com_cookies.txt)
# beside the app / in the data folder — it's auto-detected, no path needed.
# COOKIES_FILE overrides that with an explicit path.
# COOKIES_FROM_BROWSER instead reads cookies live from a logged-in browser
# (firefox / chrome / edge / brave / opera / vivaldi / chromium). On Windows,
# Chrome/Edge lock their cookie DB while open — Firefox is the most reliable.
COOKIES_FROM_BROWSER=
COOKIES_FILE=

# Dev-server bind address and port. Used only by `python app.py`.
HOST=127.0.0.1
PORT=5000
