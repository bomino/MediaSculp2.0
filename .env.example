# Copy to .env and adjust. Read at startup by config.py — except HOST/PORT,
# which are read by the `python app.py` entrypoint.

# Secret used to sign session/flash cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated per process (sessions won't survive a restart).
SECRET_KEY=

# Enable the Werkzeug debugger/reloader. NEVER enable in production (RCE risk).
FLASK_DEBUG=0

# Where media is stored. Defaults to ./downloads and ./trimmed_videos next to app.py.
DOWNLOAD_FOLDER=
TRIMMED_FOLDER=

# SQLite file for the download history. Defaults to ./mediasculp.db.
DATABASE=

# Path to the ffmpeg binary. Leave blank to resolve ffmpeg from PATH.
# Example (Windows): C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_LOCATION=

# Maximum upload size in bytes (default 524288000 = 500 MB).
MAX_UPLOAD_BYTES=524288000

# How many downloads run at once; extras queue.
MAX_CONCURRENT_DOWNLOADS=3

# Refuse to start a download below this free space (bytes); 0 disables.
MIN_FREE_BYTES=209715200

# Set to 1 to run `pip install -U yt-dlp` at startup (restart to load the new version).
AUTO_UPDATE_YTDLP=0

# Dev-server bind address and port. Used only by `python app.py`.
HOST=127.0.0.1
PORT=5000
